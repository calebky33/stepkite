{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/after-edit.mjs\"", "timeout": 45 }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm e2e)",
      "Bash(pnpm e2e:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm check:copy)",
      "Bash(pnpm check:copy:*)",
      "Bash(rtk gain:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "WebSearch",
      "WebFetch(domain:gov.uk)",
      "WebFetch(domain:www.gov.uk)",
      "WebFetch(domain:irs.gov)",
      "WebFetch(domain:www.irs.gov)",
      "WebFetch(domain:incometax.gov.in)",
      "WebFetch(domain:www.incometax.gov.in)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:opennext.js.org)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:docs.stripe.com)"
    ],
    "ask": [
      "Bash(pnpm install:*)",
      "Bash(pnpm install)",
      "Bash(pnpm i:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm uninstall:*)",
      "Bash(pnpm update:*)",
      "Bash(pnpm up:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm lint --fix:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git stash drop:*)",
      "Bash(git branch -D:*)",
      "Bash(git rebase:*)",
      "Bash(git rm:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Edit(.claude/settings*.json)",
      "Write(.claude/settings*.json)",
      "Edit(scripts/hooks/**)",
      "Write(scripts/hooks/**)",
      "Edit(scripts/check-copy.mjs)",
      "Write(scripts/check-copy.mjs)",
      "Edit(package.json)",
      "Write(package.json)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Read(**/*.pem)",
      "Read(**/.wrangler/**)",
      "Read(**/supabase/.temp/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.dev.vars)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/.dev.vars)",
      "Bash(cat *.env*)",
      "Bash(cat *.dev.vars*)",
      "Bash(type *.env*)",
      "Bash(more *.env*)",
      "Bash(git diff --no-index:*)",
      "Bash(git diff * --no-index*)",
      "Bash(git diff * --output*)",
      "Bash(git log * --output*)",
      "Bash(git add -f:*)",
      "Bash(git add --force:*)",
      "Bash(git add *.env*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --mirror*)",
      "Bash(git push * --delete*)",
      "Bash(git push * +*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r -f:*)"
    ]
  }
}
