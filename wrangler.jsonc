{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stepkite",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "stepkite" }],
  "ratelimits": [
    { "name": "RL_JOB_PREVIEW", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_NEWSLETTER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "TURNSTILE_HOSTNAMES": "stepkite.app,stepkite.calebky33.workers.dev,localhost,127.0.0.1",
    "NEXT_PUBLIC_SUPABASE_URL": "https://mnuxckbcmggmkxvjkzvu.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_1ph1wjmCAnl56_tWQYxYiQ_GsiEUhM6",
  },
  "observability": { "enabled": true },
}
