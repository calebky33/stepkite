{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stepkite",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "stepkite" }],
  "ratelimits": [
    { "name": "RL_JOB_PREVIEW", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_NEWSLETTER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "TURNSTILE_HOSTNAMES": "stepkite.calebky33.workers.dev,stepkite.com,localhost,127.0.0.1",
  },
  "observability": { "enabled": true },
}
